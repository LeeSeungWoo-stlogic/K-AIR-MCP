# K-AIR MCP 설정
# AI 에이전트는 이 MCP 주소(:8110/mcp)와 API Key만 등록하여 사용합니다.
# DB 접속 정보는 필요하지 않으며, robo-meta-api를 통해 카탈로그 파악 및 질의가 수행됩니다.

MCP_API_KEYS=your-secret-api-key

# robo-meta-api 엔드포인트 (POST /meta/catalog 및 POST /query_execute 공통)
ROBO_META_URL=http://robo-meta-api:8100

# 행 상한 (서버가 이 값을 그대로 적용)
MCP_ROW_LIMIT=200

# 바인드 호스트 및 포트
API_HOST=0.0.0.0
API_PORT=8110
