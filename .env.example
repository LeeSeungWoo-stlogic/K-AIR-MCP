# 로컬 MCP 스모크용. 값은 관리자가 CLI/.env로 넣는다. 빈 기본값 금지.
# 포털 SourceDbConn·tm_po_api_key 가 아니다. 이전 때 이 키는 폐기한다.

MCP_API_KEYS=
# 목록·허용 게이트(카탈로그 ∩ Postgres 인벤토리). SELECT 실행용이 아님.
# 분석 마트가 없으면 비워 두고 Tibero 인벤토리만 연다.
MCP_PG_HOST=host.docker.internal
MCP_PG_PORT=5434
MCP_PG_DB=
MCP_PG_USER=
MCP_PG_PASSWORD=
# POST /meta/catalog 와 POST /query_execute 공통
ROBO_META_URL=http://robo-meta-api:8100
# 행 상한. 서버가 이 값을 그대로 씀
MCP_ROW_LIMIT=200

# Tibero는 수집 인스턴스 접속이 있을 때만. 없으면 카탈로그 Tibero/oracle 소스는 목록에서 빠진다.
# JAR은 driver/tibero-jdbc.jar → 컨테이너 /opt/tibero/jdbc/tibero7-jdbc.jar
# MCP_TB_HOST=
# MCP_TB_PORT=
# MCP_TB_SID=
# MCP_TB_USER=
# MCP_TB_PASSWORD=
# MCP_TB_JDBC_JAR=/opt/tibero/jdbc/tibero7-jdbc.jar
